{
  // Worker "makeitlive": serves ./dist as static files; /api/* runs worker/index.js.
  // Cloudflare build settings: build command  `sh scripts/build-cloudflare.sh`  (creates ./dist)
  //                            deploy command `npx wrangler deploy`
  "name": "makeitlive",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
